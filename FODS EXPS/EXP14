import pandas as pd
import matplotlib.pyplot as plt

ages = [
    21, 25, 30, 35, 28, 22, 25, 30, 40, 35,
    29, 32, 24, 26, 31, 28, 35, 40, 45, 30,
    22, 25, 27, 33, 36, 29, 31, 38, 42, 45,
    21, 23, 26, 28, 32, 34, 37, 39, 41, 44,
    25, 30, 35, 40, 22, 27, 33, 36, 29, 31,
    24, 28, 32, 35, 38, 42, 46, 48, 50, 55,
    23, 26, 29, 33, 37, 41, 45, 49, 52, 56,
    22, 27, 31, 34, 39, 43, 47, 51, 54, 58
]

data = pd.DataFrame({"Age": ages})

# Calculate frequency
frequency = data["Age"].value_counts().sort_index()

print("Customer Age Frequency:")
print(frequency)

# Display total customers
print("\nTotal Customers:", len(data))

# Bar Graph
plt.figure(figsize=(12, 5))
frequency.plot(kind="bar")
plt.title("Customer Age Frequency Distribution")
plt.xlabel("Customer Age")
plt.ylabel("Number of Customers")
plt.show()