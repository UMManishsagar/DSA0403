import pandas as pd
import matplotlib.pyplot as plt

likes = [
    100, 150, 200, 250, 300, 150, 200, 350, 400, 250,
    500, 450, 300, 200, 150, 600, 550, 400, 350, 250,
    100, 200, 300, 400, 500, 600, 700, 800, 450, 350,
    150, 250, 350, 450, 550, 650, 750, 850, 300, 200,
    100, 400, 500, 600, 700, 250, 350, 450, 550, 650,
    120, 180, 220, 280, 320, 380, 420, 480, 520, 580,
    620, 680, 720, 780, 820, 880, 920, 950, 1000, 1100,
    130, 170, 230, 270, 330, 370, 430, 470, 530, 570
]

data = pd.DataFrame({"Likes": likes})

# Calculate frequency
frequency = data["Likes"].value_counts().sort_index()

print("Likes Frequency Distribution:")
print(frequency)

# Display total posts
print("\nTotal Posts:", len(data))

# Bar Graph
plt.figure(figsize=(12, 5))
frequency.plot(kind="bar")
plt.title("Frequency Distribution of Post Likes")
plt.xlabel("Number of Likes")
plt.ylabel("Number of Posts")
plt.show()