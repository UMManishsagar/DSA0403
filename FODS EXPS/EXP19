# Calculate confidence interval
def confidence_interval(data):
    n = len(data)
    mean = np.mean(data)
    std = np.std(data, ddof=1)
    se = std / np.sqrt(n)
    t = stats.t.ppf(0.975, n-1)
    margin = t * se
    return mean, mean-margin, mean+margin

# Drug group
d_mean, d_low, d_high = confidence_interval(df["Drug"])

# Placebo group
