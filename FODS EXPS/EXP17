# Stop words
stop_words = {
    "the", "is", "and", "a", "an", "to", "of", "in", "it",
    "was", "very", "with", "this", "that", "for", "on",
    "my", "i", "am", "are", "but", "because", "its", "be",
    "not", "has", "have", "had", "after", "at", "too",
    "will", "would", "me", "we", "our", "they", "their",
    "by", "from", "as", "or", "if", "so", "well", "again"
}

# Combine all feedback
all_text = " ".join(feedback)

# Convert to lowercase
all_text = all_text.lower()

# Remove punctuation and extract words
words = re.findall(r'\b[a-z]+\b', all_text)

# Remove stop words
filtered_words = [word for word in words if word not in stop_words]

# Calculate word frequency
word_frequency = Counter(filtered_words)

# Get N from user
n = int(input("Enter the number of top words: "))

# Display top N words
top_words = word_frequency.most_common(n)

print("\nTOP", n, "MOST FREQUENT WORDS")
print("--------------------------------")

for word, count in top_words:
    print(word, ":", count)

# Plot bar graph
if top_words:
    words_list = [item[0] for item in top_words]
    counts_list = [item[1] for item in top_words]

    plt.bar(words_list, counts_list)
    plt.xlabel("Words")
    plt.ylabel("Frequency")
    plt.title("Top N Frequent Words in Customer Feedback")
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.show()
else:
    print("No words available to plot.")
