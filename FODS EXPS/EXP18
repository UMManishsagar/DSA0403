
import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats

# Dataset input
data = {
    "Age": [23, 23, 27, 27, 39, 41, 47, 49, 50,
            52, 54, 54, 56, 57, 58, 58, 60, 61],

    "%Fat": [9.5, 26.5, 7.8, 17.8, 31.4, 25.9, 27.4, 27.2,
             31.2, 34.6, 42.5, 28.8, 33.4, 30.2, 34.1,
             32.9, 41.2, 35.7]
}

# Create DataFrame
df = pd.DataFrame(data)

print("AGE AND BODY FAT DATASET")
print(df)

# Calculate statistical measures
print("\nMEAN")
print(df.mean())

print("\nMEDIAN")
print(df.median())

print("\nSTANDARD DEVIATION")
print(df.std())

# Boxplots
plt.figure(figsize=(10, 5))

plt.subplot(1, 2, 1)
plt.boxplot(df["Age"])
plt.title("Boxplot of Age")
plt.ylabel("Age")

plt.subplot(1, 2, 2)
plt.boxplot(df["%Fat"])
plt.title("Boxplot of Body Fat")
plt.ylabel("%Fat")

plt.tight_layout()
plt.show()

# Scatter plot
plt.scatter(df["Age"], df["%Fat"])
plt.xlabel("Age")
plt.ylabel("Body Fat Percentage")
plt.title("Scatter Plot of Age vs Body Fat")
plt.grid()
plt.show()

# Q-Q plots
plt.figure(figsize=(10, 5))

plt.subplot(1, 2, 1)
stats.probplot(df["Age"], dist="norm", plot=plt)
plt.title("Q-Q Plot of Age")

plt.subplot(1, 2, 2)
stats.probplot(df["%Fat"], dist="norm", plot=plt)
plt.title("Q-Q Plot of Body Fat")

plt.tight_layout()
plt.show()
