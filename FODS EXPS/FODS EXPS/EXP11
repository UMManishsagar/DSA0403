import matplotlib.pyplot as plt

months = [
    "Jan-23", "Feb-23", "Mar-23", "Apr-23",
    "May-23", "Jun-23", "Jul-23", "Aug-23",
    "Sep-23", "Oct-23", "Nov-23", "Dec-23",
    "Jan-24", "Feb-24", "Mar-24", "Apr-24",
    "May-24", "Jun-24", "Jul-24", "Aug-24",
    "Sep-24", "Oct-24", "Nov-24", "Dec-24",
    "Jan-25", "Feb-25", "Mar-25", "Apr-25",
    "May-25", "Jun-25", "Jul-25", "Aug-25",
    "Sep-25", "Oct-25", "Nov-25", "Dec-25"
]

sales = [
    120, 150, 180, 160, 200, 220,
    250, 230, 270, 300, 320, 350,
    140, 170, 190, 180, 220, 240,
    280, 260, 290, 330, 350, 380,
    160, 190, 210, 200, 250, 270,
    300, 280, 320, 360, 390, 420
]

# Line Plot
plt.figure(figsize=(12, 5))
plt.plot(months, sales, marker='o')
plt.title("Product Sales - Line Plot")
plt.xlabel("Months")
plt.ylabel("Sales")
plt.xticks(rotation=90)
plt.grid()
plt.show()

# Scatter Plot
plt.figure(figsize=(12, 5))
plt.scatter(months, sales)
plt.title("Product Sales - Scatter Plot")
plt.xlabel("Months")
plt.ylabel("Sales")
plt.xticks(rotation=90)
plt.show()

# Bar Plot
plt.figure(figsize=(12, 5))
plt.bar(months, sales)
plt.title("Product Sales - Bar Plot")
plt.xlabel("Months")
plt.ylabel("Sales")
plt.xticks(rotation=90)
plt.show()